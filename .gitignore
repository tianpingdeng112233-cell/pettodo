.DS_Store
xcuserdata/
build/
DerivedData/

# Python tool/test caches
__pycache__/
*.py[cod]
.pytest_cache/

# Hatch backend runtime and local secrets
backend/node_modules/
backend/dist/
backend/data/
backend/.env
!backend/.env.example

# Flutter build artifacts
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
# Generation pipeline scratch (large, reproducible) is ignored; report
# evidence that the write-up cites is kept.
artifacts/*
!artifacts/screenshots/
!artifacts/report/
test/failures/
